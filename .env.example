# Local development only: copy to .env. Production writes its own on the host.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
WEB_IMAGE=wayfinder-web:local
API_IMAGE=wayfinder-api:local
SITE_DOMAIN=localhost
DATABASE_PASSWORD=wayfinder-local
# Local-only values; production reads its own from SSM. Generate fresh ones with `openssl rand -hex 32`.
JWT_SECRET=local-only-jwt-secret-not-for-production-use
DATA_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f
