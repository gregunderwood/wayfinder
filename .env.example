# Copy to .env for local development. One file serves Docker Compose, the Nest
# dev server and the TypeORM CLI. Production writes its own .env on the host,
# with the password read from SSM; nothing below is a production value.

# Compose: the images docker-compose.local.yml builds, and the site Caddy
# serves. `localhost` makes Caddy use its internal CA, not Let's Encrypt.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
WEB_IMAGE=wayfinder-web:local
API_IMAGE=wayfinder-api:local
SITE_DOMAIN=localhost

# Postgres. The API defaults to 127.0.0.1:5432, user and database `wayfinder`,
# which is where docker-compose.local.yml publishes it for `nx serve server`.
DATABASE_PASSWORD=wayfinder-local
