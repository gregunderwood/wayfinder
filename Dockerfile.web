# The public site: Angular SSR on Node, served behind Caddy.
#
# The Angular application builder bundles every server-side dependency into
# server/server.mjs, so the runtime stage carries the 3 MB build and nothing
# from node_modules — no dev tooling, no compiler, far less to patch.

FROM node:22.23.4-bookworm-slim AS build
WORKDIR /repo

# The Cypress binary is a several-hundred-megabyte download that only the e2e
# suite uses; the build never touches it.
ENV CYPRESS_INSTALL_BINARY=0 \
    NX_DAEMON=false \
    NX_NO_CLOUD=true

# Manifests first so the dependency layer is reused until they change.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npx nx build web --configuration=production

FROM node:22.23.4-alpine AS runtime
ENV NODE_ENV=production \
    PORT=4000
WORKDIR /app

COPY --from=build --chown=node:node /repo/dist/apps/web ./

USER node
EXPOSE 4000
CMD ["node", "server/server.mjs"]
