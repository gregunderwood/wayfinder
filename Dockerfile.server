# The API: NestJS on Node, reached only through Caddy under /api.
#
# Webpack bundles the app's own code and leaves node_modules external, writing a
# package.json and lockfile that list only what the bundle imports. The runtime
# stage installs exactly that set, so no dev tooling, TypeScript or ts-node
# ships. Migrations run from the bundle (`node main.js migrate:run`), not
# through the TypeORM CLI.

FROM node:22.23.4-bookworm-slim AS build
WORKDIR /repo

ENV CYPRESS_INSTALL_BINARY=0 \
    NX_DAEMON=false \
    NX_NO_CLOUD=true

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npx nx build server --configuration=production
# Nx's pruned lockfile can drop a nested copy of a package that the root
# lockfile holds (express's own content-type, for one), and `npm ci` then
# refuses it as out of sync. Re-resolving against the pruned file keeps every
# version it already pins and adds only the missing entries.
RUN npm install --package-lock-only --no-audit --no-fund --prefix dist/apps/server

FROM node:22.23.4-alpine AS runtime
ENV NODE_ENV=production \
    PORT=3000
WORKDIR /app

COPY --from=build /repo/dist/apps/server/package.json /repo/dist/apps/server/package-lock.json ./
# --omit=peer: TypeORM declares ts-node (and through it TypeScript and swc,
# 140 MB) as an optional peer for its CLI. Every peer the bundle does load
# (pg, reflect-metadata, rxjs) is a direct dependency, so it stays.
RUN npm ci --omit=dev --omit=peer --no-audit --no-fund && npm cache clean --force

COPY --from=build /repo/dist/apps/server ./

USER node
EXPOSE 3000
CMD ["node", "main.js"]
