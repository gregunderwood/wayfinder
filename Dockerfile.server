FROM node:22.23.4-bookworm-slim AS build
WORKDIR /repo

ENV CYPRESS_INSTALL_BINARY=0 \
    NX_DAEMON=false \
    NX_NO_CLOUD=true

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
RUN npx nx build server --configuration=production
# Nx's pruned lockfile can drop nested packages, which `npm ci` then rejects.
RUN npm install --package-lock-only --no-audit --no-fund --prefix dist/apps/server

FROM node:22.23.4-alpine AS runtime
ENV NODE_ENV=production \
    PORT=3000
WORKDIR /app

COPY --from=build /repo/dist/apps/server/package.json /repo/dist/apps/server/package-lock.json ./
# TypeORM's optional ts-node peer would add 140 MB of compilers.
RUN npm ci --omit=dev --omit=peer --no-audit --no-fund && npm cache clean --force

COPY --from=build /repo/dist/apps/server ./

USER node
EXPOSE 3000
CMD ["node", "main.js"]
